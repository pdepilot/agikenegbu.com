# AG Ikenebgu & SDTG — Clean SEO URLs
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS (uncomment when SSL is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# AG Ikenebgu clean URLs
RewriteRule ^about/?$ about.html [L]
RewriteRule ^ministries/?$ activity.html [L]
RewriteRule ^events/?$ event.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^donate/?$ donate.html [L]
RewriteRule ^give/?$ donate.html [L,R=301]
RewriteRule ^sermons/?$ sermon-library/index.html [L]
RewriteRule ^send-down-thy-glory/?$ sdgt/index.html [L,R=301]

# SDTG clean URLs
RewriteRule ^sdgt/about/?$ sdgt/about.html [L]
RewriteRule ^sdgt/gallery/?$ sdgt/gallery.html [L]
RewriteRule ^sdgt/speakers/?$ sdgt/speakers.html [L]
RewriteRule ^sdgt/registration/?$ sdgt/registration.html [L]
RewriteRule ^sdgt/register/?$ sdgt/registration.html [L,R=301]
RewriteRule ^sdgt/livestream/?$ sdgt/livestream.html [L]
RewriteRule ^sdgt/donate/?$ sdgt/donate.html [L]
RewriteRule ^sdgt/contact/?$ sdgt/contact.html [L]
RewriteRule ^sdgt/?$ sdgt/index.html [L]

# Legacy redirects
RewriteRule ^sermon\.html$ /sermons [L,R=301]
RewriteRule ^activity\.html$ /ministries [L,R=301]
RewriteRule ^event\.html$ /events [L,R=301]
RewriteRule ^send_down_thy_glory\.html$ /sdgt/ [L,R=301]
</IfModule>

# Performance headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set X-Robots-Tag "index, follow"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
